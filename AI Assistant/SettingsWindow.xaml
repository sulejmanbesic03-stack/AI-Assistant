<Window x:Class="AI_Assistant.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Assistant · Settings"
        Width="720"
        Height="610"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="Beta Runtime Settings" FontSize="24" FontWeight="Bold" />
            <TextBlock Margin="0,6,0,24"
                       Text="Unity + Blender integration and free-first model policy. API keys remain environment variables and are never stored here."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}" />

            <TextBlock Text="Unity project root" FontWeight="SemiBold" />
            <TextBox x:Name="UnityRootTextBox" Margin="0,7,0,6" Padding="10" Background="#11182A" Foreground="White" BorderBrush="#24304A" />
            <TextBlock Text="Example: C:\Users\sulja\source\repos\AIIntegrationProject" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />

            <TextBlock Margin="0,20,0,0" Text="Blender executable" FontWeight="SemiBold" />
            <TextBox x:Name="BlenderExeTextBox" Margin="0,7,0,6" Padding="10" Background="#11182A" Foreground="White" BorderBrush="#24304A" />
            <TextBlock Text="Path to blender.exe. The app also checks common Blender 4.x install paths." FontSize="11" Foreground="{StaticResource MutedTextBrush}" />

            <TextBlock Margin="0,20,0,0" Text="Blender workspace" FontWeight="SemiBold" />
            <TextBox x:Name="BlenderWorkspaceTextBox" Margin="0,7,0,6" Padding="10" Background="#11182A" Foreground="White" BorderBrush="#24304A" />

            <CheckBox x:Name="PreferFreeCheckBox"
                      Margin="0,22,0,0"
                      Content="Prefer free providers and fall back only when needed"
                      Foreground="White" />
            <CheckBox x:Name="ApprovalCheckBox"
                      Margin="0,12,0,0"
                      Content="Require approval for destructive/high-risk changes"
                      Foreground="White" />

            <TextBlock Margin="0,20,0,0" Text="Maximum model calls per task" FontWeight="SemiBold" />
            <TextBox x:Name="MaxCallsTextBox" Width="100" HorizontalAlignment="Left" Margin="0,7,0,0" Padding="10" Background="#11182A" Foreground="White" BorderBrush="#24304A" />

            <Border Margin="0,24,0,0" Padding="14" Background="#0E1525" BorderBrush="#24304A" BorderThickness="1" CornerRadius="10">
                <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Foreground="#A9B5C9" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Margin="0,0,10,0" Background="#263149" Click="ValidateButton_Click" Content="Validate" />
                <Button Click="SaveButton_Click" Content="Save settings" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
