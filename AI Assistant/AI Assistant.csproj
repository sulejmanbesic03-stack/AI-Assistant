<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>

		<OutputType>WinExe</OutputType>

		<TargetFramework>net8.0-windows</TargetFramework>

		<UseWPF>true</UseWPF>

		<RootNamespace>AI_Assistant</RootNamespace>

		<ImplicitUsings>enable</ImplicitUsings>

		<Nullable>enable</Nullable>

	</PropertyGroup>


	<ItemGroup>

		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />

		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />

		<PackageReference Include="OpenAI" Version="2.12.0" />

	</ItemGroup>



	<!--
    TempTools contains AI-generated C# source files.
    They are compiled manually by Roslyn at runtime.
    The normal AI Assistant build must NEVER compile them.
    -->

	<ItemGroup>

		<!-- WPF App.xaml generates the application entry point. -->
		<!-- Keep the old console bootstrap as reference, but do not compile it. -->
		<Compile Remove="Program.cs" />

		<None Include="Program.cs" />



		<Compile Remove="TempTools\**\*.cs" />

		<None Include="TempTools\**\*.cs" />


		<Compile Remove="CapabilityLibrary\source\**\*.cs" />

		<None Include="CapabilityLibrary\source\**\*.cs" />


		<!-- Only UnityCommandExecutorCurrent.cs is authoritative for Agent V2. -->
		<Compile Remove="AgentV2\UnityCommandExecutor.cs" />
		<None Include="AgentV2\UnityCommandExecutor.cs" />

		<Compile Remove="AgentV2\UnityCommandExecutorFixed.cs" />
		<None Include="AgentV2\UnityCommandExecutorFixed.cs" />

	</ItemGroup>

	<ItemGroup>
	  <Page Include="App.xaml" />
	</ItemGroup>
</Project>
