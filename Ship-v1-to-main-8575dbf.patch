diff --git a/.github/workflows/beta-build.yml b/.github/workflows/beta-build.yml
new file mode 100644
index 0000000..dfffa09
--- /dev/null
+++ b/.github/workflows/beta-build.yml
@@ -0,0 +1,43 @@
+name: Beta Build
+
+on:
+  push:
+    branches:
+      - beta/ship-v1
+  pull_request:
+    branches:
+      - main
+
+jobs:
+  build-windows:
+    runs-on: windows-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup .NET 8
+        uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: 8.0.x
+
+      - name: Restore
+        run: dotnet restore "AI Assistant/AI Assistant.csproj"
+
+      - name: Restore updater
+        run: dotnet restore "AI Assistant Updater/AI Assistant Updater.csproj"
+
+      - name: Build Release
+        run: dotnet build "AI Assistant/AI Assistant.csproj" -c Release --no-restore --warnaserror
+
+      - name: Publish desktop app
+        run: dotnet publish "AI Assistant/AI Assistant.csproj" -c Release -r win-x64 --self-contained false -o artifacts/AI-Assistant
+
+      - name: Publish updater
+        run: dotnet publish "AI Assistant Updater/AI Assistant Updater.csproj" -c Release -r win-x64 --self-contained false -o artifacts/AI-Assistant-Updater
+
+      - name: Upload beta artifacts
+        uses: actions/upload-artifact@v4
+        with:
+          name: ai-assistant-beta-win-x64
+          path: artifacts/
+          if-no-files-found: error
